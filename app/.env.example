# --- Projet Supabase -------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://<votre-projet>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<votre-cle-publishable>

# --- Clé de service Supabase ----------------------------------------------
# Nécessaire uniquement à la gestion des comptes (création, mot de passe,
# désactivation) depuis l'écran d'administration.
# Supabase → Project Settings → API Keys → service_role / secret.
SUPABASE_SECRET_KEY=<votre-cle-secrete>

# --- OpenAI ----------------------------------------------------------------
# Nécessaire uniquement à la rédaction des relances WhatsApp.
# https://platform.openai.com/api-keys
OPENAI_API_KEY=<votre-cle-openai>
# Facultatif : modèle utilisé. Par défaut gpt-4o-mini.
# OPENAI_MODEL=gpt-4o-mini

# AUCUNE de ces trois clés secrètes ne doit être préfixée NEXT_PUBLIC_ :
# tout ce qui porte ce préfixe part dans le bundle navigateur.
