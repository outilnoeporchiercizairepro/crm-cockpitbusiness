# Modèle pour un déploiement Docker « nu ». Copier en .env à côté du
# docker-compose.yml, puis renseigner les valeurs.
#
# Sur Dokploy, ne pas utiliser ce fichier : saisir ces trois variables
# directement dans l'onglet Environment de l'application.

# Publiques : elles partent dans le navigateur par conception.
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx

# Secrète : contourne toute la RLS. Ne jamais la committer, ne jamais la
# passer en argument de build.
SUPABASE_SECRET_KEY=sb_secret_xxx
